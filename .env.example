# Local development only. Run scripts/init-dev.py to create .env securely.
# This placeholder is not a working password. Never commit .env.
CORE_ENVIRONMENT=development
CORE_SERVICE_NAME=The Editing Tab Core
CORE_DB_HOST=127.0.0.1
# Host port; PostgreSQL inside Docker always uses 5432.
CORE_DB_PORT=15432
CORE_DB_NAME=editingtab_core
CORE_DB_USERNAME=editingtab_dev
CORE_DB_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
# Integer seconds, allowed range 2..10.
CORE_DB_CONNECT_TIMEOUT=3
# Separate disposable test container host port. Tests never read this file.
CORE_TEST_DB_PORT=15433