# Local development only. Run scripts/init-dev.py to create .env securely.
# This placeholder is not a working password. Never commit .env.
CORE_ENVIRONMENT=development
CORE_SERVICE_NAME=The Editing Tab Core
CORE_DB_HOST=127.0.0.1
# Host port; PostgreSQL inside Docker always uses 5432.
CORE_DB_PORT=15432
CORE_DB_NAME=editingtab_core
CORE_DB_USERNAME=editingtab_dev
CORE_DB_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
# Integer seconds, allowed range 2..10.
CORE_DB_CONNECT_TIMEOUT=3
# Separate disposable test container host port. Tests never read this file.
CORE_TEST_DB_PORT=15433
# Exact Booking frontend browser origin(s), JSON array; no path or trailing slash.
# Local frontend and Core URLs must use the same hostname (for example, both 127.0.0.1).
# Existing .env files are not overwritten by the initializer.
CORE_AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:18080"]
# Absolute lifetime in seconds (60..604800), default eight hours.
CORE_AUTH_SESSION_SECONDS=28800
# Fixed login window (1..3600 seconds), per-account and per-source limits.
CORE_AUTH_WINDOW_SECONDS=300
CORE_AUTH_ACCOUNT_LIMIT=5
CORE_AUTH_SOURCE_LIMIT=30
# Explicit development/test uses a SameSite=Lax HTTP cookie. All other modes use
# a Secure, SameSite=None cookie for credentialed HTTPS browser requests.

# Optional Booking-only internal authentication; unset disables integration.
# Load lowercase SHA-256 digests via private deployment configuration, never raw secrets.
# CORE_BOOKING_SERVICE_CURRENT_DIGEST=<64 lowercase hex characters>
# CORE_BOOKING_SERVICE_PREVIOUS_DIGEST=<previous digest during rotation only>
